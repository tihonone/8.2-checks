# Lateral Movement with Credentials Using Net Utility
# Controlled, read-only SMB EDR test against an authorized remote share.
#
# Prompts for IP address, share name, and username.
# net.exe prompts for the password; the script never reads or stores it.
# Lists names in the root of the share, then removes only its own connection.
#
# Does not create a remote share, copy files, execute remote commands,
# access admin shares, modify the remote machine, or save credentials.

$ErrorActionPreference = 'Stop'

$NetExe = Join-Path $env:WINDIR 'System32\net.exe'
$DriveLetter = 'N:'
$Connected = $false

if (-not (Test-Path -LiteralPath $NetExe -PathType Leaf)) {
    throw "net.exe was not found: $NetExe"
}

$IpAddress = (Read-Host 'IP address of the authorized test machine').Trim()

$ParsedAddress = $null
if (
    -not [System.Net.IPAddress]::TryParse(
        $IpAddress,
        [ref]$ParsedAddress
    ) -or
    $ParsedAddress.AddressFamily -ne
        [System.Net.Sockets.AddressFamily]::InterNetwork
) {
    throw 'Enter a valid IPv4 address.'
}

$ShareName = (Read-Host 'Name of the authorized test SMB share (without \\)').Trim()

if ($ShareName -notmatch '^[A-Za-z0-9_-]{1,80}$') {
    throw 'The share name may contain only Latin letters, digits, underscores, and hyphens.'
}

# Do not use this test to access administrative or hidden shares.
if ($ShareName.EndsWith('$')) {
    throw 'Hidden and administrative shares are not used in this test.'
}

$UserName = (Read-Host 'Username (for example, DOMAIN\User or HOST\User)').Trim()

if (
    [string]::IsNullOrWhiteSpace($UserName) -or
    $UserName -match '[\s"''/]' -or
    $UserName.Length -gt 256
) {
    throw 'Enter a non-empty username without spaces, quotation marks, or the / character.'
}

$UncPath = "\\$IpAddress\$ShareName"
$DriveRoot = "$DriveLetter\"

# Query the selected drive letter without treating "mapping not found" as fatal.
# This check does not contact the remote SMB share.
$PreviousErrorActionPreference = $ErrorActionPreference

try {
    $ErrorActionPreference = 'Continue'
    $null = & $NetExe use $DriveLetter 2>$null
    $MappingQueryExitCode = $LASTEXITCODE
}
finally {
    $ErrorActionPreference = $PreviousErrorActionPreference
}

# Never disconnect or replace an existing network mapping.
if ($MappingQueryExitCode -eq 0) {
    throw "Drive $DriveLetter is already mapped. The script will not change an existing connection."
}

# A local drive with the same letter must also remain untouched.
if (Test-Path -LiteralPath $DriveRoot) {
    throw "Drive letter $DriveLetter is already in use. Select another available letter in the script."
}

Write-Host "Target: $UncPath"
Write-Host "Username: $UserName"
Write-Host 'net.exe will now prompt for the password; do not enter it on the command line.'

try {
    # The literal * requests a password prompt from net.exe.
    & $NetExe use $DriveLetter $UncPath '*' "/user:$UserName" '/persistent:no'
    $ConnectExitCode = $LASTEXITCODE

    if ($ConnectExitCode -ne 0) {
        throw "net use connection failed with exit code $ConnectExitCode."
    }

    $Connected = $true

    Write-Host ''
    Write-Host "Connection established: $DriveLetter -> $UncPath"
    Write-Host 'Contents of the test share root (names and types only):'

    Get-ChildItem -LiteralPath $DriveRoot -ErrorAction Stop |
        Select-Object Name, PSIsContainer |
        Format-Table -AutoSize

    Write-Host 'Test completed: explicit-credential connection and share-root enumeration were performed.'
}
finally {
    if ($Connected) {
        # Do not let a cleanup error hide the result of the main test.
        $PreviousErrorActionPreference = $ErrorActionPreference

        try {
            $ErrorActionPreference = 'Continue'
            & $NetExe use $DriveLetter '/delete' '/y'
            $DisconnectExitCode = $LASTEXITCODE
        }
        finally {
            $ErrorActionPreference = $PreviousErrorActionPreference
        }

        if ($DisconnectExitCode -ne 0) {
            Write-Warning "Could not automatically disconnect $DriveLetter. Check the connection manually."
        }
        else {
            Write-Host "Test connection $DriveLetter was disconnected."
        }
    }
}